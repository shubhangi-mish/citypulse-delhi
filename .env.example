# Copy to .env (repo root) and fill in. Never commit .env.

# --- Graph database (FalkorDB) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=citypulse

# --- PostgreSQL (sessions, operators, audit, source runs, notifications) ---
POSTGRES_PASSWORD=citypulse_dev
DATABASE_URL=postgresql+psycopg://citypulse:citypulse_dev@localhost:55432/citypulse

# --- Security ---
# Long random string; signs session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# Set true when served over HTTPS
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3100

# --- CityPulse Command operator accounts ---
# Comma-separated username:pbkdf2-hash pairs. Generate a hash with:
#   cd apps/api && uv run python -m app.security.hash_password
OPERATOR_ACCOUNTS=

# --- Mapbox (map tiles + address search). Public token (pk.*) is used in the browser. ---
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional server-side token for geocoding; falls back to NEXT_PUBLIC_MAPBOX_TOKEN, then to OSM Nominatim.
MAPBOX_TOKEN=

# --- LLM for agents (optional). Without a key, agents run in deterministic graph-only mode
# and say so on every decision record. ---
LLM_PROVIDER=none        # none | openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- External data ---
# Contact string sent in User-Agent to OSM services (required by their usage policies)
DATA_CONTACT=citypulse-delhi-hackathon
